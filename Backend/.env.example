# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated browser origins allowed by CORS (leave empty for native-only clients)
CORS_ORIGINS=
# true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# ── Database ───────────────────────────────────────────────────
DATABASE_DIALECT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hustle
DATABASE_USER=postgres
DATABASE_PASSWORD=
# true for managed/production databases that require TLS (certificate is verified)
DATABASE_SSL=false

# ── Auth ───────────────────────────────────────────────────────
# At least 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Access-token lifetime in seconds (60-3600)
JWT_ACCESS_EXPIRES_IN=900
# Refresh-token lifetime in seconds (default 30 days)
REFRESH_TOKEN_EXPIRES_IN=2592000

# ── NestJS Observe (optional) ──────────────────────────────────
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
