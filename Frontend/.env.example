# Copy to .env (or .env.local) and adjust. Never commit real env files.
#
# EXPO_PUBLIC_* values are inlined into the app bundle and are readable by anyone
# with the app. Only put public configuration here, never secrets.

# Base URL of the NestJS backend (no trailing slash, no /auth suffix).
#   iOS simulator / web:  http://localhost:4000
#   Android emulator:     http://10.0.2.2:4000
#   Physical device:      http://<your-computer-LAN-IP>:4000
# Production builds require https:// (enforced at startup in src/config/env.ts).
EXPO_PUBLIC_API_URL=http://localhost:4000
